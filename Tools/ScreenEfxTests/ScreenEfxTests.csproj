<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(HARMONY_PATH)</HarmonyPath>
  </PropertyGroup>
  <Target Name="ValidateExternalPaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RimWorldDir)' == ''" Text="未指定游戏目录：用 -p:RimWorldDir=... 或环境变量 RIMWORLD_DIR。" />
    <Error Condition="'$(HarmonyPath)' == ''" Text="未指定 0Harmony.dll：用 -p:HarmonyPath=... 或环境变量 HARMONY_PATH。" />
  </Target>
  <ItemGroup>
    <Compile Include="../../Source/RimUnity/ScreenEfx/EfxGpuPipeline.cs" Link="Runtime/EfxGpuPipeline.cs" />
    <Compile Include="../../Source/RimUnity/ScreenEfx/EfxClip.cs;../../Source/RimUnity/ScreenEfx/EfxPlayer.cs;../../Source/RimUnity/ScreenEfx/EfxFrameBuilder.cs" Link="Runtime/%(Filename)%(Extension)" />
    <Compile Include="../../Source/RimUnity/ScreenEfx/EfxBufferBudget.cs;../../Source/RimUnity/ScreenEfx/EfxRendererFactory.cs;../../Source/RimUnity/ScreenEfx/EfxRenderContext.cs" Link="Runtime/%(Filename)%(Extension)" />
    <Reference Include="../../1.7/Assemblies/RimUnity.Core.dll" />
    <Reference Include="$(RimWorldDir)/Waylith.dll;$(RimWorldDir)/Waylith.UnityCompat.dll;$(RimWorldDir)/UnityStubs.dll;$(RimWorldDir)/Brutal.Core.*.dll;$(RimWorldDir)/Brutal.Vulkan*.dll;$(RimWorldDir)/Brutal.ImGui.dll" Private="false" />
    <Reference Include="$(HarmonyPath)" />
  </ItemGroup>
</Project>
