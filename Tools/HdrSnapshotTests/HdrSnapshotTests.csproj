<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(HARMONY_PATH)</HarmonyPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Source/RimUnity/Diagnostics/DpaDiagnostics.cs" Link="Runtime/DpaDiagnostics.cs" />
    <Compile Include="../../Source/RimUnity/Rendering/Hdr/HdrDrawFrame.cs" Link="Runtime/HdrDrawFrame.cs" />
    <Compile Include="../../Source/RimUnity/Rendering/Hdr/FrameMetadataCopier.cs" Link="Runtime/FrameMetadataCopier.cs" />
    <Compile Include="../../Source/RimUnity/Rendering/Hdr/HdrMaterialBindings.cs" Link="Runtime/HdrMaterialBindings.cs" />
    <Reference Include="$(RimWorldDir)/Waylith.dll;$(RimWorldDir)/Waylith.UnityCompat.dll;$(RimWorldDir)/UnityStubs.dll;$(RimWorldDir)/Brutal.Core.*.dll;$(RimWorldDir)/Brutal.Vulkan*.dll;$(RimWorldDir)/Brutal.ImGui.dll" Private="false" />
    <Reference Include="$(HarmonyPath)" />
  </ItemGroup>
</Project>
