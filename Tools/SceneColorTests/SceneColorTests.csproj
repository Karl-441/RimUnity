<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Source/RimUnity/Rendering/Bloom/BloomPreviewContext.cs" Link="Runtime/BloomPreviewContext.cs" />
    <Compile Include="../../Source/RimUnity/Rendering/Hdr/HdrTransferPass.cs" Link="Runtime/HdrTransferPass.cs" />
    <Reference Include="$(RimWorldDir)/Waylith.dll;$(RimWorldDir)/Waylith.UnityCompat.dll;$(RimWorldDir)/UnityStubs.dll;$(RimWorldDir)/Brutal.Core.*.dll;$(RimWorldDir)/Brutal.Vulkan*.dll" Private="false" />
  </ItemGroup>
</Project>
