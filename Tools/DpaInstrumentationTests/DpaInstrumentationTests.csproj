<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><LangVersion>latest</LangVersion>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(HARMONY_PATH)</HarmonyPath>
    <DpaRoot Condition="'$(DpaRoot)' == '' and '$(RimWorldDir)' != ''">$(RimWorldDir)/Mods/Dubs Performance Analyzer/Source/Profiling</DpaRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Condition="'$(DpaSource)' != ''" Include="$(DpaSource)/H_RimUnity.cs;$(DpaSource)/RimUnityTiming.cs;$(DpaSource)/RimUnityProbeBridge.cs;$(DpaSource)/RimUnitySortStages.cs;$(DpaSource)/RimUnitySubmitStages.cs;$(DpaSource)/ClipboardReport.cs" />
    <Compile Condition="'$(DpaSource)' == ''" Include="$(DpaRoot)/Patches/Update/H_RimUnity.cs;$(DpaRoot)/Patches/Update/RimUnitySortStages.cs;$(DpaRoot)/Patches/Update/RimUnitySubmitStages.cs;$(DpaRoot)/Statistics/RimUnityTiming.cs;$(DpaRoot)/Statistics/RimUnityProbeBridge.cs;$(DpaRoot)/GUI/ClipboardReport.cs" />
    <Compile Include="../../Source/RimUnity/Diagnostics/DpaDiagnostics.cs" Link="DpaDiagnostics.cs" />
    <Reference Include="0Harmony" HintPath="$(HarmonyPath)" />
  </ItemGroup>
  <Target Name="ValidateTestPaths" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DpaSource)' == '' and '$(DpaRoot)' == ''" Text="Set RIMWORLD_DIR, -p:DpaRoot=&lt;Source/Profiling&gt;, or -p:DpaSource=&lt;staging directory&gt;." />
    <Error Condition="'$(HarmonyPath)' == '' or !Exists('$(HarmonyPath)')" Text="Set HARMONY_PATH or -p:HarmonyPath to an existing 0Harmony.dll." />
  </Target>
</Project>
